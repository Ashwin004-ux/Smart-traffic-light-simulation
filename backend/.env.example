# Backend Environment Configuration
PROJECT_NAME="Smart Traffic Light Simulation"
DEBUG=True
API_V1_STR="/api"

# Database Configuration (PostgreSQL with SQLite fallback)
# Use PostgreSQL: postgresql://postgres:postgres@localhost:5432/traffic_db
# Or SQLite: sqlite:///./traffic_system.db
DATABASE_URL="sqlite:///./traffic_system.db"

# Computer Vision / YOLO Configuration
YOLO_MODEL_PATH="yolov8n.pt"
CONFIDENCE_THRESHOLD=0.50

# Traffic Algorithm Default Weights
WEIGHT_VEHICLE_COUNT=0.45
WEIGHT_QUEUE_LENGTH=0.30
WEIGHT_WAITING_TIME=0.25

# Signal Timings (Seconds)
MIN_GREEN_DURATION=10
MAX_GREEN_DURATION=60
YELLOW_DURATION=3
ALL_RED_DURATION=2

# CORS Origins
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "*"]
